# Copy this file to .env.local (never commit real keys)

# Supabase — Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Long password you make up. Used to unlock Admin → CRM / Members / Campaigns
OPS_ADMIN_SECRET=

# Stripe (Dashboard → Developers → API keys + webhook)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Email (optional — campaigns + receipts). https://resend.com
RESEND_API_KEY=
RESEND_FROM=GorditoPass <hello@gorditopass.com>

# Google Maps
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_BRAND_NAME=GorditoPass
