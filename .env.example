# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
OPS_ADMIN_SECRET=

# Cloudflare R2 (photo storage — free 10 GB tier)
# Dashboard → R2 → Manage R2 API tokens → create token with Object Read & Write
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=gorditopass-photos
# Public URL for the bucket (r2.dev subdomain or custom domain like https://images.yourdomain.com)
R2_PUBLIC_BASE_URL=

# Stripe (later)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
